@model LocacaoVeiculos.Models.Locacao

@{
    ViewData["Title"] = "Excluir locação";
}

<h1>Excluir locação</h1>

<div class="alert alert-warning">
    Tem certeza de que deseja excluir esta locação?
</div>

<dl class="row">

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">
        @Model.Cliente?.Nome
    </dd>

    <dt class="col-sm-3">Veículo</dt>
    <dd class="col-sm-9">
        @Model.Veiculo?.Marca @Model.Veiculo?.Modelo
    </dd>

    <dt class="col-sm-3">Período</dt>
    <dd class="col-sm-9">
        @Model.DataInicio.ToString("dd/MM/yyyy")
        até
        @Model.DataFim.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-3">Valor total</dt>
    <dd class="col-sm-9">
        @Model.ValorTotal.ToString("C")
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">
        Confirmar exclusão
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>
