@model LocacaoVeiculos.Models.CategoriaVeiculo

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<div class="container mt-4">
    <h2>Detalhes da Categoria</h2>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Descricao)
                        ? "Sem descrição"
                        : Model.Descricao)
        </dd>

        <dt class="col-sm-3">Valor da diária</dt>
        <dd class="col-sm-9">
            @Model.ValorDiaria.ToString("C")
        </dd>
    </dl>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>
</div>
